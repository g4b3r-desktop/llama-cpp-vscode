{
  "name": "llama-cpp-assistant",
  "displayName": "llama.cpp Assistant",
  "description": "Copilot-like VS Code experience for local or remote llama.cpp: native Chat integration, status-bar controls, per-language inline suggestions, code actions, autocomplete, RAG and performance metrics.",
  "version": "0.7.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {"vscode": "^1.117.0"},
  "categories": ["Machine Learning", "Other"],
  "keywords": ["AI", "FIM", "RAG", "autocomplete", "chat participant", "llama", "llama.cpp", "local LLM", "native chat", "inline edit", "inline suggestions", "status bar", "Copilot alternative", "Markdown", "TTFT"],
  "activationEvents": ["onStartupFinished"],
  "main": "./src/extension.js",
  "scripts": {
    "check": "node --check src/extension.js && node --check src/config.js && node --check src/http.js && node --check src/localServer.js && node --check src/llamaClient.js && node --check src/autocomplete.js && node --check src/chatPanel.js && node --check src/workspaceIndex.js && node --check src/performance.js && node --check src/nativeModelProvider.js && node --check src/nativeChat.js && node --check src/editorActions.js && node --check src/inlineSuggestionsController.js && node --check media/chat.js",
    "package": "npx @vscode/vsce package"
  },
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "g4b3r-llamacpp",
        "displayName": "llama.cpp",
        "managementCommand": "llamaCpp.manageProvider"
      }
    ],
    "chatParticipants": [
      {
        "id": "llama-cpp-assistant.llama",
        "name": "llama",
        "fullName": "llama.cpp Assistant",
        "description": "Ask your local or remote llama.cpp model about code",
        "isSticky": true,
        "commands": [
          {"name": "explain", "description": "Explain selected or attached code"},
          {"name": "fix", "description": "Find a bug and propose a focused fix"},
          {"name": "review", "description": "Review code for correctness, security and maintainability"},
          {"name": "tests", "description": "Generate focused tests"},
          {"name": "refactor", "description": "Suggest a behavior-preserving refactor"},
          {"name": "codebase", "description": "Answer using workspace RAG context"}
        ]
      }
    ],
    "commands": [
      {"command": "llamaCpp.openChat", "title": "Llama.cpp: Open Native Chat", "icon": "$(comment-discussion)"},
      {"command": "llamaCpp.openClassicChat", "title": "Llama.cpp: Open Classic Chat"},
      {"command": "llamaCpp.openInlineStatusMenu", "title": "Llama.cpp: Configure Inline Suggestions"},
      {"command": "llamaCpp.askSelection", "title": "Llama.cpp: Ask About Selection", "icon": "$(sparkle)"},
      {"command": "llamaCpp.inlineEdit", "title": "Llama.cpp: Inline Edit", "icon": "$(edit)"},
      {"command": "llamaCpp.fixSelection", "title": "Llama.cpp: Fix Selection"},
      {"command": "llamaCpp.refactorSelection", "title": "Llama.cpp: Refactor Selection"},
      {"command": "llamaCpp.reviewSelection", "title": "Llama.cpp: Review Selection"},
      {"command": "llamaCpp.generateTests", "title": "Llama.cpp: Generate Tests"},
      {"command": "llamaCpp.manageProvider", "title": "Llama.cpp: Manage Model Provider"},
      {"command": "llamaCpp.setApiKey", "title": "Llama.cpp: Set API Key"},
      {"command": "llamaCpp.clearApiKey", "title": "Llama.cpp: Clear API Key"},
      {"command": "llamaCpp.testConnection", "title": "Llama.cpp: Test Connection"},
      {"command": "llamaCpp.triggerCompletion", "title": "Llama.cpp: Trigger Inline Completion"},
      {"command": "llamaCpp.reindexWorkspace", "title": "Llama.cpp: Reindex Workspace (RAG)"},
      {"command": "llamaCpp.showIndexStatus", "title": "Llama.cpp: Show RAG Index Status"},
      {"command": "llamaCpp.setRagApiKey", "title": "Llama.cpp: Set RAG API Key"},
      {"command": "llamaCpp.clearRagApiKey", "title": "Llama.cpp: Clear RAG API Key"},
      {"command": "llamaCpp.showPerformanceMetrics", "title": "Llama.cpp: Show Performance Metrics"}
    ],
    "submenus": [
      {"id": "llamaCpp.editorActions", "label": "llama.cpp Assistant"}
    ],
    "menus": {
      "editor/context": [
        {"submenu": "llamaCpp.editorActions", "when": "editorTextFocus", "group": "navigation@100"}
      ],
      "llamaCpp.editorActions": [
        {"command": "llamaCpp.inlineEdit", "group": "1_edit@1"},
        {"command": "llamaCpp.fixSelection", "group": "1_edit@2"},
        {"command": "llamaCpp.refactorSelection", "group": "1_edit@3"},
        {"command": "llamaCpp.askSelection", "group": "2_chat@1"},
        {"command": "llamaCpp.reviewSelection", "group": "2_chat@2"},
        {"command": "llamaCpp.generateTests", "group": "2_chat@3"}
      ],
      "editor/title": [
        {"command": "llamaCpp.openChat", "group": "navigation@100", "when": "editorTextFocus"}
      ]
    },
    "configuration": {
      "title": "llama.cpp Assistant",
      "properties": {
        "llamaCpp.mode": {"type": "string", "enum": ["local", "api"], "default": "local", "description": "Use a locally installed llama-server, or connect to a remote API URL."},
        "llamaCpp.local.executable": {"type": "string", "default": "llama-server"},
        "llamaCpp.local.modelPath": {"type": "string", "default": ""},
        "llamaCpp.local.host": {"type": "string", "default": "127.0.0.1"},
        "llamaCpp.local.port": {"type": "number", "default": 8080},
        "llamaCpp.local.autoStart": {"type": "boolean", "default": true},
        "llamaCpp.local.args": {"type": "array", "items": {"type": "string"}, "default": []},
        "llamaCpp.api.baseUrl": {"type": "string", "default": "http://127.0.0.1:8080"},
        "llamaCpp.api.model": {"type": "string", "default": "", "description": "Default model. Native VS Code Chat can choose among models returned by /v1/models."},
        "llamaCpp.autocomplete.enabled": {"type": "boolean", "default": true, "description": "Master switch for llama.cpp inline suggestions."},
        "llamaCpp.autocomplete.enable": {
          "type": "object",
          "default": {"*": true, "plaintext": false, "markdown": false, "scminput": false},
          "additionalProperties": {"type": "boolean"},
          "description": "Enable or disable inline suggestions by VS Code language ID. '*' is the default. Language-specific entries override '*', similar to github.copilot.enable."
        },
        "llamaCpp.autocomplete.backend": {"type": "string", "enum": ["auto", "fim", "openai"], "default": "auto"},
        "llamaCpp.autocomplete.profile": {"type": "string", "enum": ["fast", "balanced", "quality"], "default": "fast", "description": "Latency profile. Fast and balanced use only an already-loaded local BM25 index for related files; quality can use the full configured RAG pipeline."},
        "llamaCpp.autocomplete.maxTokens": {"type": "number", "default": 48},
        "llamaCpp.autocomplete.temperature": {"type": "number", "default": 0.1},
        "llamaCpp.autocomplete.contextLinesBefore": {"type": "number", "default": 40},
        "llamaCpp.autocomplete.contextLinesAfter": {"type": "number", "default": 10},
        "llamaCpp.autocomplete.maxPrefixCharacters": {"type": "number", "default": 6000},
        "llamaCpp.autocomplete.maxSuffixCharacters": {"type": "number", "default": 1800},
        "llamaCpp.autocomplete.maxPredictMs": {"type": "number", "default": 1200},
        "llamaCpp.autocomplete.debounceMs": {"type": "number", "default": 140},
        "llamaCpp.autocomplete.relatedFilesEnabled": {"type": "boolean", "default": true},
        "llamaCpp.autocomplete.relatedFilesTopK": {"type": "number", "default": 1},
        "llamaCpp.autocomplete.relatedFilesMaxCharacters": {"type": "number", "default": 3000},
        "llamaCpp.chat.maxTokens": {"type": "number", "default": 1024},
        "llamaCpp.chat.temperature": {"type": "number", "default": 0.3},
        "llamaCpp.chat.streaming": {"type": "boolean", "default": true},
        "llamaCpp.chat.includeEditorContext": {"type": "boolean", "default": true, "description": "Default automatic editor context. Native Chat attachments always remain explicit."},
        "llamaCpp.chat.maxContextCharacters": {"type": "number", "default": 24000},
        "llamaCpp.chat.includeVisibleEditors": {"type": "boolean", "default": true},
        "llamaCpp.chat.maxVisibleFiles": {"type": "number", "default": 4},
        "llamaCpp.chat.maxVisibleContextCharacters": {"type": "number", "default": 16000},
        "llamaCpp.chat.workspaceContextCharacters": {"type": "number", "default": 24000},
        "llamaCpp.chat.mentionedFilesMaxCharacters": {"type": "number", "default": 30000},
        "llamaCpp.chat.maxMentionedFiles": {"type": "number", "default": 6},
        "llamaCpp.rag.enabled": {"type": "boolean", "default": true},
        "llamaCpp.rag.autoIndex": {"type": "boolean", "default": true},
        "llamaCpp.rag.watchWorkspace": {"type": "boolean", "default": true},
        "llamaCpp.rag.includeGlob": {"type": "string", "default": "**/*.{js,jsx,ts,tsx,mjs,cjs,py,java,c,cc,cpp,h,hpp,cs,go,rs,php,rb,swift,kt,kts,scala,sh,bash,zsh,lua,vue,svelte,html,css,scss,less,json,jsonc,yaml,yml,toml,xml,md,mdx,sql,graphql,gql,proto}"},
        "llamaCpp.rag.excludeGlob": {"type": "string", "default": "**/{node_modules,.git,dist,build,out,.next,.nuxt,.venv,venv,target,vendor,coverage,.cache}/**"},
        "llamaCpp.rag.maxFiles": {"type": "number", "default": 2000},
        "llamaCpp.rag.maxFileBytes": {"type": "number", "default": 524288},
        "llamaCpp.rag.chunkLines": {"type": "number", "default": 80},
        "llamaCpp.rag.chunkOverlapLines": {"type": "number", "default": 20},
        "llamaCpp.rag.topK": {"type": "number", "default": 6},
        "llamaCpp.rag.strategy": {"type": "string", "enum": ["auto", "bm25", "vector", "hybrid"], "default": "auto"},
        "llamaCpp.rag.embedding.enabled": {"type": "boolean", "default": true},
        "llamaCpp.rag.embedding.baseUrl": {"type": "string", "default": ""},
        "llamaCpp.rag.embedding.model": {"type": "string", "default": ""},
        "llamaCpp.rag.embedding.batchSize": {"type": "number", "default": 16},
        "llamaCpp.rag.embedding.maxCharacters": {"type": "number", "default": 6000},
        "llamaCpp.rag.rerank.enabled": {"type": "boolean", "default": false},
        "llamaCpp.rag.rerank.baseUrl": {"type": "string", "default": ""},
        "llamaCpp.rag.rerank.model": {"type": "string", "default": ""},
        "llamaCpp.rag.rerank.candidates": {"type": "number", "default": 20},
        "llamaCpp.rag.cache.enabled": {"type": "boolean", "default": true},
        "llamaCpp.rag.cache.maxMegabytes": {"type": "number", "default": 128},
        "llamaCpp.metrics.showStatusBar": {"type": "boolean", "default": true},
        "llamaCpp.request.timeoutMs": {"type": "number", "default": 120000}
      }
    }
  }
}
