{
  "name": "llama-cpp-assistant",
  "displayName": "llama.cpp Assistant",
  "description": "Copilot-like VS Code assistant for local/remote llama.cpp or OpenAI: native Chat, autonomous agent tools, controlled web research, inline suggestions, RAG and performance metrics.",
  "version": "0.10.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {"vscode": "^1.117.0"},
  "categories": ["Machine Learning", "Other"],
  "keywords": ["AI", "agent", "agent mode", "tools", "FIM", "RAG", "autocomplete", "chat participant", "llama", "llama.cpp", "OpenAI", "ChatGPT", "Responses API", "GPT", "local LLM", "native chat", "inline edit", "inline suggestions", "Copilot alternative", "rollback", "web search", "web research", "Brave Search", "SearXNG"],
  "activationEvents": ["onStartupFinished"],
  "main": "./src/extension.js",
  "scripts": {
    "check": "node --check src/extension.js && node --check src/config.js && node --check src/http.js && node --check src/localServer.js && node --check src/llamaClient.js && node --check src/openai/OpenAIClient.js && node --check src/openai/responseUtils.js && node --check src/autocomplete.js && node --check src/chatPanel.js && node --check src/workspaceIndex.js && node --check src/performance.js && node --check src/nativeModelProvider.js && node --check src/nativeChat.js && node --check src/editorActions.js && node --check src/inlineSuggestionsController.js && node --check src/agent/AgentController.js && node --check src/agent/AgentRunner.js && node --check src/tools/ToolRegistry.js && node --check src/tools/registerCoreTools.js && node --check src/workspace/pathSafety.js && node --check src/workspace/diff.js && node --check src/workspace/WorkspaceService.js && node --check src/terminal/TerminalService.js && node --check src/permissions/PermissionService.js && node --check src/history/AgentHistory.js && node --check src/llm/AgentModel.js && node --check src/llm/LlamaAgentModel.js && node --check src/llm/OpenAIAgentModel.js && node --check src/web/urlSafety.js && node --check src/web/WebResearchService.js && node --check media/chat.js",
    "test": "node --test test/*.test.js",
    "package": "npx @vscode/vsce package"
  },
  "contributes": {
    "languageModelChatProviders": [{"vendor": "g4b3r-llamacpp", "displayName": "llama.cpp / OpenAI", "managementCommand": "llamaCpp.manageProvider"}],
    "chatParticipants": [{
      "id": "llama-cpp-assistant.llama",
      "name": "llama",
      "fullName": "llama.cpp Assistant",
      "description": "Ask or run an autonomous coding agent using llama.cpp or OpenAI",
      "isSticky": true,
      "commands": [
        {"name": "agent", "description": "Run an autonomous workspace agent with controlled file, search, diagnostics and terminal tools"},
        {"name": "research", "description": "Perform detailed web research with multiple controlled sources and return links"},
        {"name": "explain", "description": "Explain selected or attached code"},
        {"name": "fix", "description": "Find a bug and propose a focused fix"},
        {"name": "review", "description": "Review code for correctness, security and maintainability"},
        {"name": "tests", "description": "Generate focused tests"},
        {"name": "refactor", "description": "Suggest a behavior-preserving refactor"},
        {"name": "codebase", "description": "Answer using workspace RAG context"}
      ]
    }],
    "commands": [
      {"command": "llamaCpp.openChat", "title": "Llama.cpp: Open Native Chat", "icon": "$(comment-discussion)"},
      {"command": "llamaCpp.runAgent", "title": "Llama.cpp: Run Agent", "icon": "$(tools)"},
      {"command": "llamaCpp.rollbackAgent", "title": "Llama.cpp: Roll Back Last Agent Changes"},
      {"command": "llamaCpp.setWebSearchApiKey", "title": "Llama.cpp: Set Web Search API Key"},
      {"command": "llamaCpp.clearWebSearchApiKey", "title": "Llama.cpp: Clear Web Search API Key"},
      {"command": "llamaCpp.openClassicChat", "title": "Llama.cpp: Open Classic Chat"},
      {"command": "llamaCpp.openInlineStatusMenu", "title": "Llama.cpp: Configure Inline Suggestions"},
      {"command": "llamaCpp.askSelection", "title": "Llama.cpp: Ask About Selection", "icon": "$(sparkle)"},
      {"command": "llamaCpp.inlineEdit", "title": "Llama.cpp: Inline Edit", "icon": "$(edit)"},
      {"command": "llamaCpp.fixSelection", "title": "Llama.cpp: Fix Selection"},
      {"command": "llamaCpp.refactorSelection", "title": "Llama.cpp: Refactor Selection"},
      {"command": "llamaCpp.reviewSelection", "title": "Llama.cpp: Review Selection"},
      {"command": "llamaCpp.generateTests", "title": "Llama.cpp: Generate Tests"},
      {"command": "llamaCpp.manageProvider", "title": "Llama.cpp: Manage Model Provider"},
      {"command": "llamaCpp.setApiKey", "title": "Llama.cpp: Set llama.cpp/API Key"},
      {"command": "llamaCpp.clearApiKey", "title": "Llama.cpp: Clear llama.cpp/API Key"},
      {"command": "llamaCpp.setOpenAIApiKey", "title": "Llama.cpp: Set OpenAI API Key"},
      {"command": "llamaCpp.clearOpenAIApiKey", "title": "Llama.cpp: Clear OpenAI API Key"},
      {"command": "llamaCpp.testConnection", "title": "Llama.cpp: Test Connection"},
      {"command": "llamaCpp.triggerCompletion", "title": "Llama.cpp: Trigger Inline Completion"},
      {"command": "llamaCpp.reindexWorkspace", "title": "Llama.cpp: Reindex Workspace (RAG)"},
      {"command": "llamaCpp.showIndexStatus", "title": "Llama.cpp: Show RAG Index Status"},
      {"command": "llamaCpp.setRagApiKey", "title": "Llama.cpp: Set RAG API Key"},
      {"command": "llamaCpp.clearRagApiKey", "title": "Llama.cpp: Clear RAG API Key"},
      {"command": "llamaCpp.showPerformanceMetrics", "title": "Llama.cpp: Show Performance Metrics"}
    ],
    "submenus": [{"id": "llamaCpp.editorActions", "label": "llama.cpp Assistant"}],
    "menus": {
      "editor/context": [{"submenu": "llamaCpp.editorActions", "when": "editorTextFocus", "group": "navigation@100"}],
      "llamaCpp.editorActions": [
        {"command": "llamaCpp.inlineEdit", "group": "1_edit@1"},
        {"command": "llamaCpp.fixSelection", "group": "1_edit@2"},
        {"command": "llamaCpp.refactorSelection", "group": "1_edit@3"},
        {"command": "llamaCpp.askSelection", "group": "2_chat@1"},
        {"command": "llamaCpp.reviewSelection", "group": "2_chat@2"},
        {"command": "llamaCpp.generateTests", "group": "2_chat@3"},
        {"command": "llamaCpp.runAgent", "group": "3_agent@1"}
      ],
      "editor/title": [{"command": "llamaCpp.openChat", "group": "navigation@100", "when": "editorTextFocus"}]
    },
    "configuration": {
      "title": "llama.cpp Assistant",
      "properties": {
        "llamaCpp.provider": {"type": "string", "enum": ["llamacpp", "openai"], "default": "llamacpp", "description": "Primary model provider for Chat, Agent Mode and code actions."},
        "llamaCpp.openai.baseUrl": {"type": "string", "default": "https://api.openai.com/v1", "description": "OpenAI API base URL. The extension uses the Responses API for Chat and Agent Mode."},
        "llamaCpp.openai.model": {"type": "string", "default": "gpt-5.6-luna", "description": "Default OpenAI model. The VS Code model picker can select another model returned by the API."},
        "llamaCpp.openai.reasoningEffort": {"type": "string", "enum": ["none", "low", "medium", "high", "xhigh", "max"], "default": "low", "description": "Reasoning effort sent to OpenAI Responses API models that support it."},
        "llamaCpp.openai.store": {"type": "boolean", "default": false, "description": "Whether OpenAI Responses API may store generated responses. Disabled by default."},
        "llamaCpp.openai.useForAutocomplete": {"type": "boolean", "default": false, "description": "Allow paid OpenAI API calls for inline autocomplete. Disabled by default to avoid high request volume/cost."},
        "llamaCpp.openai.useForEmbeddings": {"type": "boolean", "default": false, "description": "Use the OpenAI API for RAG embeddings when no custom embedding endpoint is configured. Disabled by default to avoid unexpected cost."},
        "llamaCpp.openai.embeddingModel": {"type": "string", "default": "text-embedding-3-small", "description": "OpenAI embedding model used when OpenAI embeddings are explicitly enabled."},
        "llamaCpp.mode": {"type": "string", "enum": ["local", "api"], "default": "local", "description": "llama.cpp provider only: use a locally installed llama-server, or connect to a remote OpenAI-compatible llama.cpp API URL."},
        "llamaCpp.local.executable": {"type": "string", "default": "llama-server"},
        "llamaCpp.local.modelPath": {"type": "string", "default": ""},
        "llamaCpp.local.host": {"type": "string", "default": "127.0.0.1"},
        "llamaCpp.local.port": {"type": "number", "default": 8080},
        "llamaCpp.local.autoStart": {"type": "boolean", "default": true},
        "llamaCpp.local.args": {"type": "array", "items": {"type": "string"}, "default": []},
        "llamaCpp.api.baseUrl": {"type": "string", "default": "http://127.0.0.1:8080"},
        "llamaCpp.api.model": {"type": "string", "default": "", "description": "Default llama.cpp/OpenAI-compatible model. Native VS Code Chat can choose among models returned by /v1/models."},
        "llamaCpp.agent.enabled": {"type": "boolean", "default": true, "description": "Enable the autonomous controlled-tool agent exposed as @llama /agent."},
        "llamaCpp.agent.maxSteps": {"type": "number", "default": 30, "minimum": 1, "maximum": 100, "description": "Maximum LLM/tool iterations per agent task."},
        "llamaCpp.agent.maxTokensPerStep": {"type": "number", "default": 2048, "minimum": 64},
        "llamaCpp.agent.temperature": {"type": "number", "default": 0.1, "minimum": 0, "maximum": 2},
        "llamaCpp.agent.confirmFileWrites": {"type": "boolean", "default": false, "description": "Ask before normal file create/edit operations. Delete and move always require approval."},
        "llamaCpp.agent.confirmTerminalCommands": {"type": "boolean", "default": true, "description": "Ask before terminal commands. Dangerous commands always require approval even if disabled."},
        "llamaCpp.agent.terminalTimeoutMs": {"type": "number", "default": 120000, "minimum": 1000},
        "llamaCpp.agent.maxTerminalOutputCharacters": {"type": "number", "default": 40000, "minimum": 1000},
        "llamaCpp.agent.maxToolResultCharacters": {"type": "number", "default": 30000, "minimum": 1000},
        "llamaCpp.agent.web.enabled": {"type": "boolean", "default": true, "description": "Enable controlled web search/fetch/research tools for Agent Mode."},
        "llamaCpp.agent.web.provider": {"type": "string", "enum": ["auto", "brave", "searxng"], "default": "auto", "description": "Search provider. auto uses Brave when a web search API key is stored, otherwise SearXNG."},
        "llamaCpp.agent.web.searxngBaseUrl": {"type": "string", "default": "http://127.0.0.1:8888", "description": "SearXNG base URL. JSON format must be enabled on the instance."},
        "llamaCpp.agent.web.language": {"type": "string", "default": "", "description": "Optional default web search language code, e.g. pt-br or en."},
        "llamaCpp.agent.web.maxResults": {"type": "number", "default": 8, "minimum": 1, "maximum": 20},
        "llamaCpp.agent.web.maxSources": {"type": "number", "default": 5, "minimum": 1, "maximum": 10},
        "llamaCpp.agent.web.maxFetchCharacters": {"type": "number", "default": 20000, "minimum": 1000, "maximum": 100000},
        "llamaCpp.agent.web.maxResearchCharacters": {"type": "number", "default": 30000, "minimum": 4000, "maximum": 80000},
        "llamaCpp.agent.web.timeoutMs": {"type": "number", "default": 15000, "minimum": 1000, "maximum": 120000},
        "llamaCpp.agent.web.allowedDomains": {"type": "array", "items": {"type": "string"}, "default": [], "description": "Optional allowlist. When non-empty, fetch/research only reads these domains and subdomains."},
        "llamaCpp.agent.web.blockedDomains": {"type": "array", "items": {"type": "string"}, "default": [], "description": "Domains and subdomains that web fetch/research must never read."},
        "llamaCpp.autocomplete.enabled": {"type": "boolean", "default": true, "description": "Master switch for inline suggestions."},
        "llamaCpp.autocomplete.enable": {"type": "object", "default": {"*": true, "plaintext": false, "markdown": false, "scminput": false}, "additionalProperties": {"type": "boolean"}, "description": "Enable or disable inline suggestions by VS Code language ID. '*' is the default."},
        "llamaCpp.autocomplete.backend": {"type": "string", "enum": ["auto", "fim", "openai"], "default": "auto"},
        "llamaCpp.autocomplete.profile": {"type": "string", "enum": ["fast", "balanced", "quality"], "default": "fast"},
        "llamaCpp.autocomplete.maxTokens": {"type": "number", "default": 48},
        "llamaCpp.autocomplete.temperature": {"type": "number", "default": 0.1},
        "llamaCpp.autocomplete.contextLinesBefore": {"type": "number", "default": 40},
        "llamaCpp.autocomplete.contextLinesAfter": {"type": "number", "default": 10},
        "llamaCpp.autocomplete.maxPrefixCharacters": {"type": "number", "default": 6000},
        "llamaCpp.autocomplete.maxSuffixCharacters": {"type": "number", "default": 1800},
        "llamaCpp.autocomplete.maxPredictMs": {"type": "number", "default": 1200},
        "llamaCpp.autocomplete.debounceMs": {"type": "number", "default": 140},
        "llamaCpp.autocomplete.relatedFilesEnabled": {"type": "boolean", "default": true},
        "llamaCpp.autocomplete.relatedFilesTopK": {"type": "number", "default": 1},
        "llamaCpp.autocomplete.relatedFilesMaxCharacters": {"type": "number", "default": 3000},
        "llamaCpp.chat.maxTokens": {"type": "number", "default": 1024},
        "llamaCpp.chat.temperature": {"type": "number", "default": 0.3},
        "llamaCpp.chat.streaming": {"type": "boolean", "default": true},
        "llamaCpp.chat.includeEditorContext": {"type": "boolean", "default": true},
        "llamaCpp.chat.maxContextCharacters": {"type": "number", "default": 24000},
        "llamaCpp.chat.includeVisibleEditors": {"type": "boolean", "default": true},
        "llamaCpp.chat.maxVisibleFiles": {"type": "number", "default": 4},
        "llamaCpp.chat.maxVisibleContextCharacters": {"type": "number", "default": 16000},
        "llamaCpp.chat.workspaceContextCharacters": {"type": "number", "default": 24000},
        "llamaCpp.chat.mentionedFilesMaxCharacters": {"type": "number", "default": 30000},
        "llamaCpp.chat.maxMentionedFiles": {"type": "number", "default": 6},
        "llamaCpp.rag.enabled": {"type": "boolean", "default": true},
        "llamaCpp.rag.autoIndex": {"type": "boolean", "default": true},
        "llamaCpp.rag.watchWorkspace": {"type": "boolean", "default": true},
        "llamaCpp.rag.includeGlob": {"type": "string", "default": "**/*.{js,jsx,ts,tsx,mjs,cjs,py,java,c,cc,cpp,h,hpp,cs,go,rs,php,rb,swift,kt,kts,scala,sh,bash,zsh,lua,vue,svelte,html,css,scss,less,json,jsonc,yaml,yml,toml,xml,md,mdx,sql,graphql,gql,proto}"},
        "llamaCpp.rag.excludeGlob": {"type": "string", "default": "**/{node_modules,.git,dist,build,out,.next,.nuxt,.venv,venv,target,vendor,coverage,.cache}/**"},
        "llamaCpp.rag.maxFiles": {"type": "number", "default": 2000},
        "llamaCpp.rag.maxFileBytes": {"type": "number", "default": 524288},
        "llamaCpp.rag.chunkLines": {"type": "number", "default": 80},
        "llamaCpp.rag.chunkOverlapLines": {"type": "number", "default": 20},
        "llamaCpp.rag.topK": {"type": "number", "default": 6},
        "llamaCpp.rag.strategy": {"type": "string", "enum": ["auto", "bm25", "vector", "hybrid"], "default": "auto"},
        "llamaCpp.rag.embedding.enabled": {"type": "boolean", "default": true},
        "llamaCpp.rag.embedding.baseUrl": {"type": "string", "default": ""},
        "llamaCpp.rag.embedding.model": {"type": "string", "default": ""},
        "llamaCpp.rag.embedding.batchSize": {"type": "number", "default": 16},
        "llamaCpp.rag.embedding.maxCharacters": {"type": "number", "default": 6000},
        "llamaCpp.rag.rerank.enabled": {"type": "boolean", "default": false},
        "llamaCpp.rag.rerank.baseUrl": {"type": "string", "default": ""},
        "llamaCpp.rag.rerank.model": {"type": "string", "default": ""},
        "llamaCpp.rag.rerank.candidates": {"type": "number", "default": 20},
        "llamaCpp.rag.cache.enabled": {"type": "boolean", "default": true},
        "llamaCpp.rag.cache.maxMegabytes": {"type": "number", "default": 128},
        "llamaCpp.metrics.showStatusBar": {"type": "boolean", "default": true},
        "llamaCpp.request.timeoutMs": {"type": "number", "default": 120000}
      }
    }
  }
}
